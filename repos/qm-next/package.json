{
  "name": "@qm/monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "bash scripts/build-vendor.sh",
    "test": "node --import tsx/esm --test packages/*/tests/*.test.ts",
    "test:pg": "bash scripts/run-pg.sh",
    "test:all": "node --import tsx/esm scripts/run-all-tests.ts",
    "test:architecture": "bash scripts/architecture-gate.sh",
    "test:cli": "node --import tsx/esm scripts/qa-cli.ts",
    "test:user-stories": "node --import tsx/esm scripts/qa-user-stories.ts",
    "test:smoke-wave2": "node --import tsx/esm scripts/qa-smoke-wave2.ts",
    "test:sandbox-real": "node --import tsx/esm scripts/qa-sandbox-real.ts",
    "test:sandbox-policy": "node --import tsx/esm scripts/qa-sandbox-policy.ts",
    "migrate:qm": "node --import tsx/esm scripts/migrate-qm.ts",
    "rehearsal:migrate": "bash scripts/run-migration-rehearsal.sh",
    "rehearsal:backup": "bash scripts/run-backup-rehearsal.sh",
    "rehearsal:cutover": "bash scripts/run-cutover-rehearsal.sh",
    "check:im": "bash scripts/check-im-isolation.sh",
    "rescope-check": "bash scripts/rescope-check.sh",
    "sandbox:local:build": "bash scripts/local-sandbox-build.sh",
    "typecheck": "tsc -b vendor/cosmokit vendor/schemastery vendor/cordis vendor/loader vendor/include vendor/timer && tsc -b tsconfig.json"
  },
  "devDependencies": {
    "@qm/api": "workspace:*",
    "@qm/approvals": "workspace:*",
    "@qm/boot": "workspace:*",
    "@qm/cordis-plugin-include": "workspace:*",
    "@qm/demo": "workspace:*",
    "@qm/directory": "workspace:*",
    "@qm/im-bridge": "workspace:*",
    "@qm/im-feishu": "workspace:*",
    "@qm/portal": "workspace:*",
    "@qm/reach": "workspace:*",
    "@qm/triggers": "workspace:*",
    "@qm/web-ui": "workspace:*",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@aws-sdk/client-sts": "3.1075.0"
  }
}
